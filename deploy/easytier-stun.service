[Unit]
Description=EasyTier-compatible STUN server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=easytier-stun
Group=easytier-stun
ExecStart=/usr/local/bin/easytier-stun --config /etc/easytier-stun/config.toml
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
